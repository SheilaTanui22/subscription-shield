# Copy this file to .env and fill in real values. Never commit .env.

# PayPal sandbox credentials (from developer.paypal.com), sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Local server host/port (both optional; default to 127.0.0.1:3001).
PORT=3001
# HOST=127.0.0.1

# Optional: override where local runtime data is stored (both default to
# project-root files next to this one: trials.json / budget.json). Mainly
# useful for tests or running multiple isolated instances.
# TRIALS_FILE_PATH=./trials.json
# BUDGET_FILE_PATH=./budget.json

# Optional: AI-assisted trial import ("Import from text").
#
# AI_PROVIDER picks exactly one provider — it never falls back from one to
# the other automatically:
#   ollama      (default) - free, runs 100% locally via Ollama. No API key,
#                no cloud calls. Requires Ollama running on this machine
#                (https://ollama.com) with OLLAMA_MODEL already pulled.
#   anthropic   - paid, cloud-based, only used when explicitly selected here.
AI_PROVIDER=ollama

# --- ollama (local, free) ---
# Must be a loopback address (127.0.0.1 / localhost / ::1); anything else is
# refused rather than used, so this provider can never reach the network.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional: request timeout in milliseconds (default 120000 = 2 minutes,
# generous for a cold start where Ollama has to load the model first).
OLLAMA_TIMEOUT_MS=120000
# Optional: how long Ollama keeps the model loaded after a request (default
# "15m"), so repeated extractions in a session don't re-pay the load cost.
# Measured impact is small on this setup (load was only ~6s of an ~83s cold
# run) — generation speed is what actually dominates; see OLLAMA_MODEL.
OLLAMA_KEEP_ALIVE=15m
# Optional: context window in tokens (default 8192). Sized to safely fit
# the system prompt plus a max-length (10,000-character) pasted message
# plus the response, with headroom — do not lower this without re-checking
# that math, or long pastes could silently lose context.
OLLAMA_NUM_CTX=8192

# --- anthropic (paid, cloud) --- only read when AI_PROVIDER=anthropic.
# Without this key, selecting "anthropic" shows a clear
# "AI import is not configured" message and nothing else is affected.
# Get a key at https://platform.claude.com (Anthropic API, billed
# separately from any Claude.ai or Claude desktop subscription).
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 (fast/cheap, suited to extraction) if unset.
ANTHROPIC_MODEL=claude-haiku-5-5
